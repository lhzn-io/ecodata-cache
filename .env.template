# ecodata-cache environment variables
# Copy this file to .env and fill in your credentials.
# This file is loaded by coastal-sim/docker-compose.yml via env_file.

# Copernicus Climate Data Store (CDS) credentials.
# Required for ERA5 (Tier I, >90-day hindcasts) and ERA5T (Tier II, 5–90-day hindcasts).
# Register and obtain a key at: https://cds.climate.copernicus.eu
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=your-cds-api-key-here
